# Copy to .env when the phone must use a fixed backend address.
# Android emulator default without this file: http://10.0.2.2:8080/api/v1
# iOS simulator default without this file: http://localhost:8080/api/v1
# A physical phone uses the same computer address Metro prints, on port 8080.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api/v1
